<mujoco model="vtvl_hopper">

    <compiler angle="degree" coordinate="local"/>
    
    <option gravity="0 0 -9.81"
            timestep="0.002"
            integrator="RK4"
            iterations="50"/>

    <visual>
        <headlight ambient="0.5 0.5 0.5"/>
    </visual>

    <asset>
        <texture type="skybox"
                 builtin="gradient"
                 rgb1="0.2 0.3 0.4"
                 rgb2="0 0 0"
                 width="512"
                 height="512"/>

        <material name="body_mat" rgba="0.7 0.7 0.7 1"/>
        <material name="leg_mat" rgba="0.2 0.2 0.2 1"/>
        <material name="pad_mat" rgba="0.1 0.8 0.1 1"/>
        <material name="foot_mat" rgba="0.9 0.9 0.2 1"/>
    </asset>

    <worldbody>

        <!-- ================================================= -->
        <!-- GROUND -->
        <!-- ================================================= -->

        <geom name="ground"
              type="plane"
              pos="0 0 0"
              size="20 20 0.1"
              rgba="0.3 0.3 0.3 1"
              friction="1.2 0.1 0.1"/>

        <!-- ================================================= -->
        <!-- LANDING PAD -->
        <!-- ================================================= -->

        <body name="landing_pad" pos="0 0 0">

            <geom name="pad_geom"
                  type="cylinder"
                  pos="0 0 0.01"
                  size="0.5 0.01"
                  material="pad_mat"
                  contype="1"
                  conaffinity="1"/>
        </body>

        <!-- ================================================= -->
        <!-- HOPPER -->
        <!-- ================================================= -->

        <!-- 
            IMPORTANT:
            Hopper body origin is placed at COM reference frame.
            Legs touch ground at Z=0.
        -->

        <body name="hopper" pos="0 0 0.355">

            <freejoint/>

            <!-- ================================================= -->
            <!-- INERTIA -->
            <!-- ================================================= -->

            <inertial pos="0 0 0"
                      mass="1.6"
                      diaginertia="0.025 0.025 0.008"/>

            <site name="COM"
                          pos="0 0 0.0"
                          size="0.02"
                          rgba="1 0 0 1"/>
            <!-- ================================================= -->
            <!-- MAIN BODY -->
            <!-- ================================================= -->

            <!-- 
                Body extends:
                bottom = Z=0
                top    = Z=1.0

                Relative to body origin (0.355):
                bottom = -0.355
                top    = +0.645
            -->

            <geom name="main_body"
                  type="cylinder"
                  fromto="0 0 -0.150  0 0 0.445"
                  size="0.06"
                  rgba="0.8 0.8 0.8 0.7"
                  material="body_mat"/>

            <!-- ================================================= -->
            <!-- LANDING LEGS -->
            <!-- ================================================= -->

            <!-- 
                Legs attach at Z=0.35
                Feet touch Z=0
                Radial span = 0.4 m
            -->

            <!-- LEG 1 -->
            <geom name="leg1"
                  type="capsule"
                  fromto="0 0 -0.005   0.4 0.0 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>

            <geom name="foot1_geom"
                  type="sphere"
                  pos="0.4 0 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>

            <site name="foot1"
                  pos="0.4 0 -0.355"
                  size="0.015"
                  rgba="1 0 0 1"/>

            <!-- LEG 2 -->
            <geom name="leg2"
                  type="capsule"
                  fromto="0 0 -0.005   -0.4 0 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>

            <geom name="foot2_geom"
                  type="sphere"
                  pos="-0.4 0 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>

            <site name="foot2"
                  pos="-0.4 0 -0.355"
                  size="0.015"
                  rgba="0 1 0 1"/>

            <!-- LEG 3 -->
            <geom name="leg3"
                  type="capsule"
                  fromto="0 0 -0.005   0 0.4 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>

            <geom name="foot3_geom"
                  type="sphere"
                  pos="0 0.4 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>

            <site name="foot3"
                  pos="0 0.4 -0.355"
                  size="0.015"
                  rgba="0 0 1 1"/>

            <!-- LEG 4 -->
            <geom name="leg4"
                  type="capsule"
                  fromto="0 0 -0.005   0 -0.4 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>

            <geom name="foot4_geom"
                  type="sphere"
                  pos="0 -0.4 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>

            <site name="foot4"
                  pos="0 -0.4 -0.355"
                  size="0.015"
                  rgba="1 1 0 1"/>

            <!-- ================================================= -->
            <!-- TVC SYSTEM -->
            <!-- ================================================= -->

            <!-- 
                TVC pivot location:
                Z = 0.255 from ground

                Relative to COM:
                0.255 - 0.355 = -0.100
            -->

            <body name="tvc_yaw" pos="0 0 -0.150">

                <inertial pos="0 0 0"
                          mass="0.01"
                        diaginertia="0.001 0.001 0.001"/>

                <!-- YAW -->
                  <joint name="tvc_yaw_joint"
                        type="hinge"
                        axis="1 0 0"
                        range="-25 25"
                        damping="2"
                        armature="0.01"
                        frictionloss="0.02"/>

                <body name="tvc_pitch">

                    <inertial pos="0 0 0"
                              mass="0.02"
                              diaginertia="0.0002 0.0002 0.0002"/>

                    <!-- PITCH -->
                    <joint name="tvc_pitch_joint"
                        type="hinge"
                        axis="0 1 0"
                        range="-25 25"
                        damping="2"
                        armature="0.01"
                        frictionloss="0.02"/>

                    <!-- ENGINE -->
                    <geom name="engine"
                        type="cylinder"
                        pos="0 0 -0.025"
                        size="0.04 0.02"
                        rgba="0.8 0.2 0.2 1"
                        contype="0"
                        conaffinity="0"/>

                    <!-- THRUST APPLICATION SITE -->
                    <site name="thrust_site"
                          pos="0 0 -0.10"
                          size="0.02"
                          rgba="1 0.5 0 1"/>

                </body>
            </body>

        </body>

    </worldbody>

    <!-- ================================================= -->
    <!-- ACTUATORS -->
    <!-- ================================================= -->

    <actuator>

        <position joint="tvc_yaw_joint"
                  kp="10"
                  ctrlrange="-25 25"/>

        <position joint="tvc_pitch_joint"
                  kp="10"
                  ctrlrange="-25 25"/>

    </actuator>

    <sensor>
        <user name="main_thrust_newton" dim="1"/>
        <user name="main_thrust_percent" dim="1"/>
    </sensor>

</mujoco>
